# Port & môi trường
PORT=4000
NODE_ENV=development

# Chuỗi kết nối PostgreSQL của bạn
DATABASE_URL="postgresql://postgres:password@localhost:5432/remini_db?schema=public"

# Khóa bảo vệ các endpoint quản trị (GET /api/leads, PATCH /api/leads/:id...)
ADMIN_API_KEY="change-this-admin-key-in-production"

# Tên miền được phép gọi API (phân tách bởi dấu phẩy)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://recloud.vn,https://h5.zdn.vn,https://zalo.me"

# URL trang frontend để redirect sau khi đăng nhập OAuth
FRONTEND_URL="http://localhost:5173"

# Bí mật ký JWT token — BẮT BUỘC trên production, tối thiểu 16 ký tự ngẫu nhiên
# (tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="change-this-jwt-secret-in-production"

# Email Google được coi là quản trị viên nền tảng (thấy mọi store, quản lý khách hàng / gói cước)
# Phân tách bằng dấu phẩy. Tài khoản khác đăng nhập là "chủ shop": chỉ thấy store của mình.
ADMIN_EMAILS=""

# Origin công khai của API (dùng để tạo URL ảnh upload), VD https://api.remini.vn
PUBLIC_API_ORIGIN=""

# Google OAuth 2.0 (tạo tại https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ── Zalo Mini App ──
# App Secret của Mini App (mini.zalo.me → Cài đặt → Thông tin ứng dụng). Chỉ để ở backend!
# Dùng để đổi phone token từ getPhoneNumber() lấy số điện thoại thật.
ZALO_APP_SECRET=""
# Chấp nhận CORS từ domain Zalo (h5.zdn.vn, h5.zadn.vn, *.zalo.me...). Đặt "false" để tắt.
ZALO_CORS="true"

# ── Chống spam ──
# Khoá ký form token (mặc định dùng JWT_SECRET)
ANTISPAM_SECRET=""
# Từ khoá spam bổ sung, phân tách bằng dấu phẩy
SPAM_KEYWORDS=""
# Đặt 1 khi chạy sau Nginx/Cloudflare để lấy IP thật. KHÔNG bật nếu không có proxy (client giả IP được)
TRUST_PROXY=""

# ── Thông báo cho nhân viên (bật kênh nào điền kênh đó, có thể bật cả hai) ──
# Telegram: tạo bot qua @BotFather, thêm bot vào nhóm, lấy chat id của nhóm
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Webhook chung (n8n / Zapier / Zalo OA...): nhận POST JSON { event, text, data }
NOTIFY_WEBHOOK_URL=""

# Chỉ cho server test (npm run start:test): tắt giới hạn tần suất. Bị bỏ qua khi NODE_ENV=production.
# RATE_LIMIT_DISABLED=true

# Zalo OA (hộp thư chăm sóc khách). ZALO_APP_SECRET dùng chung với đăng nhập Mini App.
ZALO_APP_ID=""
ZALO_OA_SECRET=""            # "OA Secret Key" ở Zalo for Developers > Webhook (dùng kiểm tra chữ ký)
ZALO_OA_ACCESS_TOKEN=""      # chỉ cần lần đầu; sau đó backend tự làm mới và lưu trong DB (hoặc dán ở trang Hộp thư)
ZALO_OA_REFRESH_TOKEN=""
FILE_SIGN_SECRET=""          # khoá ký URL ảnh khách (mặc định dùng JWT_SECRET)
