{
  "name": "remini-backend",
  "version": "1.0.0",
  "description": "Backend API (NestJS + Prisma + PostgreSQL) cho Zalo Mini App reMini",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test test/unit.test.ts test/inbox.unit.test.ts",
    "test:api": "node --require ts-node/register --test --test-concurrency=1 test/api.test.ts test/inbox.api.test.ts test/store-oa.api.test.ts test/billing.api.test.ts",
    "test:all": "node --require ts-node/register --test --test-concurrency=1 test/unit.test.ts test/inbox.unit.test.ts test/api.test.ts test/inbox.api.test.ts test/store-oa.api.test.ts test/billing.api.test.ts",
    "start:test": "node test/start-test-server.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
